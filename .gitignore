# Python leaves bytecode behind wherever the server or its tests are run.
__pycache__/
*.pyc

# A virtualenv for PyJWT, if you make one in the tree rather than outside it.
venv/
.venv/

# The puzzle generator can keep the candidate pool it chose the ladders from
# (--poolsOut), which is large, regenerable, and not what the game serves.
puzzles/pool*.json

.DS_Store

# The Daily pipeline's staging and checkpoint directories. Large, regenerable,
# and not what the game serves — but `puzzles/daily/work/` sits inside a
# directory that IS shipped, so one `git add puzzles/daily/` would otherwise
# commit the generator's progress logs alongside the four pools.
puzzles/daily/work/
work/daily/
